{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/home",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/post-parcel",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/send-parcel",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/carry-parcel",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/parcel-delivery",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/how-travelbuddy-works",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/safety",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/faq",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/developers",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/llms.txt",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/llms-full.txt",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/openapi.json",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/openapi.yaml",
        "destination": "/",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      ".artifacts/**",
      "tmp_*.py",
      "post-parcel/**",
      "send-parcel/**",
      "carry-parcel/**",
      "parcel-delivery/**",
      "how-travelbuddy-works/**",
      "safety/**",
      "faq/**",
      "developers/**",
      "llms.txt",
      "llms-full.txt",
      "openapi.json",
      "openapi.yaml"
    ],
    "rewrites": [
      {
        "source": "/.well-known/mcp",
        "destination": "/.well-known/mcp.json"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/llms*.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/openapi.@(json|yaml)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
