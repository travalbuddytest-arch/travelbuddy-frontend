{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/home",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/post-parcel",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/send-parcel",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/carry-parcel",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/parcel-delivery",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/how-travelbuddy-works",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/safety",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/faq",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/developers",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/llms.txt",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/llms-full.txt",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/openapi.json",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/openapi.yaml",
        "destination": "/",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      ".artifacts/**",
      "tmp_*.py",
      "post-parcel/**",
      "send-parcel/**",
      "carry-parcel/**",
      "parcel-delivery/**",
      "how-travelbuddy-works/**",
      "safety/**",
      "faq/**",
      "developers/**",
      "llms.txt",
      "llms-full.txt",
      "openapi.json",
      "openapi.yaml"
    ],
    "rewrites": [
      {
        "source": "/.well-known/mcp",
        "destination": "/.well-known/mcp.json"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://travelbuddy-backend-19l6.onrender.com https://*.firebaseapp.com https://apis.google.com https://www.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; connect-src 'self' https://travelbuddy-backend-19l6.onrender.com https://*.firebaseio.com wss://travelbuddy-backend-19l6.onrender.com https://*.firebaseapp.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebase-installations.googleapis.com https://www.gstatic.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src 'self' https://*.firebaseapp.com https://apis.google.com https://accounts.google.com https://api.razorpay.com https://checkout.razorpay.com;"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/llms*.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/openapi.@(json|yaml)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
